-- أدوات الشخصية
local function getPlayerRig()
	local char = LocalPlayer and LocalPlayer.Character
	if not char then return nil, nil, nil end
	local hrp = char:FindFirstChild("HumanoidRootPart")
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hrp or not hum or hum.Health <= 0 then return nil, nil, nil end
	return char, hrp, hum
end

local function setNoClipEnabled(enabled)
	if NoClipConnection then
		NoClipConnection:Disconnect()
		NoClipConnection = nil
	end
	if enabled then
		NoClipConnection = RunService.Stepped:Connect(function()
			safeCall(function()
				local char = LocalPlayer and LocalPlayer.Character
				if char then
					for _, obj in ipairs(char:GetDescendants()) do
						if obj:IsA("BasePart") then
							obj.CanCollide = false
						end
					end
				end
			end)
		end)
	end
end

local function cancelMoveTween()
	if ActiveTween then
		pcall(function()
			ActiveTween:Cancel()
		end)
		ActiveTween = nil
	end
end

local function tryFireTouch(hrp, coinObj)
	if typeof(firetouchinterest) ~= "function" or not hrp then return end
	pcall(function()
		local targetPart = nil
		if coinObj:IsA("BasePart") then
			targetPart = coinObj
		elseif coinObj:IsA("Model") then
			targetPart = coinObj.PrimaryPart or coinObj:FindFirstChildWhichIsA("BasePart", true)
		end
		if targetPart then
			firetouchinterest(hrp, targetPart, 0)
			task.wait(0.02)
			firetouchinterest(hrp, targetPart, 1)
		end
	end)
end

local function extractCoinTarget(obj)
	if not obj or not obj.Parent or BlacklistedCoins[obj] then
		return nil, nil
	end

	local nameLower = string.lower(obj.Name)
	local isCoinName = string.find(nameLower, "coin") ~= nil

	if obj:IsA("BasePart") and isCoinName then
		if obj.Transparency >= 0.98 then
			return nil, nil
		end
		return obj, obj.Position
	elseif obj:IsA("Model") and isCoinName then
		local part = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart", true)
		if part and part.Transparency < 0.98 then
			return part, part.Position
		end
	end

	return nil, nil
end

local function findClosestCoin(fromPos)
	local closestObj = nil
	local closestPos = nil
	local bestDistance = math.huge

	local candidateRoots = {}
	for _, item in ipairs(workspace:GetChildren()) do
		if item:IsA("Model") or item:IsA("Folder") then
			local container = item:FindFirstChild("CoinContainer") or item:FindFirstChild("Coins")
			if container then
				table.insert(candidateRoots, container)
			end
		end
	end

	if #candidateRoots == 0 then
		table.insert(candidateRoots, workspace)
	end

	for _, root in ipairs(candidateRoots) do
		for _, desc in ipairs(root:GetDescendants()) do
			local _, pos = extractCoinTarget(desc)
			if pos then
				local dist = (pos - fromPos).Magnitude
				if dist < bestDistance then
					bestDistance = dist
					closestObj = desc
					closestPos = pos
				end
			end
		end
	end

	return closestObj, closestPos, bestDistance
end

local function glideToCoin(hrp, targetPos)
	cancelMoveTween()
	sanitizeConfig()
	if not Config.Running or not hrp or not hrp.Parent then return false end

	local goalCFrame = CFrame.new(targetPos + Vector3.new(0, 1.2, 0))
	local distance = (hrp.Position - goalCFrame.Position).Magnitude
	local effectiveSpeed = math.clamp(Config.Speed * 1.35, 16, 45)
	local duration = math.clamp(distance / effectiveSpeed, 0.02, 2.2)

	local tween = TweenService:Create(
		hrp,
		TweenInfo.new(duration, Enum.EasingStyle.Linear),
		{ CFrame = goalCFrame }
	)
	ActiveTween = tween
	tween:Play()

	local elapsed = 0
	while tween.PlaybackState == Enum.PlaybackState.Playing and Config.Running do
		if not hrp or not hrp.Parent then
			cancelMoveTween()
			return false
		end
		elapsed += RunService.Heartbeat:Wait()
		if elapsed > duration + 0.35 then
			break
		end
	end

	cancelMoveTween()
	if Config.Running and hrp and hrp.Parent then
		pcall(function()
			hrp.CFrame = goalCFrame
		end)
		return true
	end
	return false
end

-- إيقاف جميع العمليات فوراً عند الضغط على STOP
local function stopAutoFarm()
	Config.Running = false
	Config.IsStarting = false

	if FarmThread then
		pcall(function()
			task.cancel(FarmThread)
		end)
		FarmThread = nil
	end

	if TimerThread then
		pcall(function()
			task.cancel(TimerThread)
		end)
		TimerThread = nil
	end

	cancelMoveTween()
	setNoClipEnabled(false)
	setStatus("Status: Stopped", Color3.fromRGB(225, 50, 50))
	updateStatsDisplay()
end

-- بدء المؤقت وحلقة الجمع مرة واحدة بدون تكرار
local function startTimer()
	if TimerThread then
		pcall(function()
			task.cancel(TimerThread)
		end)
		TimerThread = nil
	end

	TimerThread = task.spawn(function()
		while Config.Running do
			task.wait(1)
			if Config.Running then
				ElapsedSeconds += 1
				updateStatsDisplay()
			end
		end
		TimerThread = nil
	end)
end

local function startAutoFarm()
	sanitizeConfig()
	if Config.Running or Config.IsStarting or FarmThread then
		return
	end

	Config.IsStarting = true
	Config.Running = true
	table.clear(BlacklistedCoins)
	applyCharacterWalkSpeed(Config.Speed)
	setNoClipEnabled(Config.NoClip)
	setStatus("Status: Running...", Color3.fromRGB(35, 175, 85))
	updateStatsDisplay()
	startTimer()

	FarmThread = task.spawn(function()
		Config.IsStarting = false
		pcall(function()
			while Config.Running do
				sanitizeConfig()
				local _, hrp, hum = getPlayerRig()
				if not hrp or not hum then
					setStatus("Status: Waiting for character...", Color3.fromRGB(235, 145, 25))
					task.wait(0.3)
					continue
				end

				if hum.WalkSpeed ~= Config.Speed then
					hum.WalkSpeed = Config.Speed
				end

				if Config.Running then
					setStatus("Status: Running...", Color3.fromRGB(35, 175, 85))
				end

				local coinObj, coinPos = findClosestCoin(hrp.Position)
				if coinObj and coinPos then
					local reached = glideToCoin(hrp, coinPos)
					if reached and Config.Running then
						tryFireTouch(hrp, coinObj)

						local collected = false
						for _ = 1, 6 do
							if not Config.Running then break end
							local _, currentPos = extractCoinTarget(coinObj)
							if not coinObj.Parent or not currentPos then
								collected = true
								break
							end
							task.wait(0.03)
						end

						if collected then
							CoinsCollected += 1
							updateStatsDisplay()
						else
							BlacklistedCoins[coinObj] = true
						end
					end
				else
					setStatus("Status: Waiting for coins...", Color3.fromRGB(235, 145, 25))
					task.wait(0.25)
				end
			end
		end)

		cancelMoveTween()
		setNoClipEnabled(false)
		FarmThread = nil
		if not Config.Running then
			setStatus("Status: Stopped", Color3.fromRGB(225, 50, 50))
		end
	end)
end

