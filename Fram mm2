-- نظام حماية الإعدادات والتحقق من القيم
local Defaults = {
	MinSpeed = 16,
	MaxSpeed = 30,
	DefaultSpeed = 16,
	DefaultTheme = "Dark",
	InviteLink = "https://discord.gg/6yQV9faXm",
	NoClip = true
}

local Config = {
	Running = false,
	IsStarting = false,
	Speed = Defaults.DefaultSpeed,
	Theme = Defaults.DefaultTheme,
	InviteLink = Defaults.InviteLink,
	NoClip = Defaults.NoClip
}

local function sanitizeConfig()
	if typeof(Config) ~= "table" then
		Config = {
			Running = false,
			IsStarting = false,
			Speed = Defaults.DefaultSpeed,
			Theme = Defaults.DefaultTheme,
			InviteLink = Defaults.InviteLink,
			NoClip = Defaults.NoClip
		}
		return
	end

	local numSpeed = tonumber(Config.Speed)
	if not numSpeed or numSpeed ~= numSpeed then
		Config.Speed = Defaults.DefaultSpeed
	else
		Config.Speed = math.clamp(math.floor(numSpeed + 0.5), Defaults.MinSpeed, Defaults.MaxSpeed)
	end

	if Config.Theme ~= "Dark" and Config.Theme ~= "Light" then
		Config.Theme = Defaults.DefaultTheme
	end

	if typeof(Config.InviteLink) ~= "string" or Config.InviteLink == "" then
		Config.InviteLink = Defaults.InviteLink
	end

	if typeof(Config.NoClip) ~= "boolean" then
		Config.NoClip = Defaults.NoClip
	end

	if typeof(Config.Running) ~= "boolean" then
		Config.Running = false
	end

	if typeof(Config.IsStarting) ~= "boolean" then
		Config.IsStarting = false
	end
end

sanitizeConfig()

local function safeCall(fn, ...)
	local ok, result = pcall(fn, ...)
	if not ok then
		return nil
	end
	return result
end

-- نسخ الرابط تلقائياً إلى الحافظة عند تشغيل السكربت
local function copyInviteLinkOnStart()
	sanitizeConfig()
	safeCall(function()
		local clipFn = setclipboard or toclipboard or (syn and syn.write_clipboard)
		if typeof(clipFn) == "function" then
			clipFn(Config.InviteLink)
		end
	end)
end

copyInviteLinkOnStart()

