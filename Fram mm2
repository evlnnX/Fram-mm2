-- تطبيق الثيم المختار (Dark أسود أو Light أبيض)
local function applyTheme(themeName)
	sanitizeConfig()
	local chosen = (themeName == "Light") and "Light" or "Dark"
	Config.Theme = chosen
	local t = Themes[chosen]

	safeCall(function()
		MainFrame.BackgroundColor3 = t.MainBg
		MainStroke.Color = t.Stroke
		TopBar.BackgroundColor3 = t.TopBg
		TopBottomCover.BackgroundColor3 = t.TopBg
		TitleLabel.TextColor3 = t.TitleRed
		MinimizeBtn.BackgroundColor3 = t.MinBtnBg
		MinimizeBtn.TextColor3 = t.TextPrimary

		ThemeRow.BackgroundColor3 = t.CardBg
		ThemeTitle.TextColor3 = t.TextPrimary

		ProfileCard.BackgroundColor3 = t.CardBg
		DisplayNameText.TextColor3 = t.TextPrimary
		UsernameText.TextColor3 = t.TextSecondary

		CoinsCard.BackgroundColor3 = t.CardBg
		CoinsValue.TextColor3 = t.TextPrimary
		TimerCard.BackgroundColor3 = t.CardBg
		TimerValue.TextColor3 = t.TextPrimary

		SpeedCard.BackgroundColor3 = t.CardBg
		SpeedLabel.TextColor3 = t.TextPrimary
		SpeedInput.BackgroundColor3 = t.InputBg
		SpeedInput.TextColor3 = t.TextPrimary
		SpeedInput.PlaceholderColor3 = t.TextSecondary
		ResetSpeedBtn.BackgroundColor3 = t.ResetBtnBg
		ResetSpeedBtn.TextColor3 = t.TextPrimary

		if chosen == "Dark" then
			DarkThemeBtn.BackgroundColor3 = Color3.fromRGB(220, 35, 35)
			DarkThemeBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
			LightThemeBtn.BackgroundColor3 = Color3.fromRGB(42, 42, 54)
			LightThemeBtn.TextColor3 = Color3.fromRGB(210, 210, 220)
		else
